{
  "entities": {
    "ClinicalParametersDoc": {
      "title": "ClinicalParametersDoc",
      "description": "Active versioned clinical parameters and European population calibration constants used by the parametric risk engine.",
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24,
          "pattern": "^v[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest parameter publication."
        },
        "updatedBy": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "updateMode": {
          "type": "string",
          "enum": ["baseline", "guarded_auto", "manual_review", "rollback"]
        },
        "changeSummary": {
          "type": "string",
          "minLength": 4,
          "maxLength": 500
        },
        "dailyStepsOptimalThreshold": {
          "type": "number",
          "description": "Optimal daily step count threshold (guardrail 6000-10000)."
        },
        "dailyStepsLowThreshold": {
          "type": "number",
          "description": "Low daily step count sedentary threshold (guardrail 3000-5500)."
        },
        "whoWeeklyMinutesTarget": {
          "type": "number",
          "description": "WHO weekly moderate-equivalent minutes target (guardrail 120-210)."
        },
        "upfHighRiskOncoPoints": {
          "type": "number",
          "description": "Oncologic exposure weight for frequent UPF intake (guardrail 4-9)."
        },
        "redMeatWeeklyLimit": {
          "type": "number",
          "description": "WCRF/AIRC weekly red meat servings limit (guardrail 2-4)."
        },
        "fruitVegDailyTarget": {
          "type": "number",
          "description": "Daily fruit and vegetable servings target (guardrail 4-7)."
        },
        "alcoholLowRiskWeeklyLimit": {
          "type": "number",
          "description": "Weekly alcohol units threshold for risk flagging (guardrail 3-10)."
        },
        "euDefaultTotalCholMgDl": {
          "type": "number",
          "description": "European median total cholesterol for optional lipid imputation (guardrail 180-220)."
        },
        "euPopCvdMedianMultiplier": {
          "type": "number",
          "description": "European CVD reference cohort calibration multiplier (guardrail 0.85-1.15)."
        },
        "euPopOncoMedianOffset": {
          "type": "number",
          "description": "European EPIC/AIRC oncology median offset (guardrail -5 to 5)."
        },
        "score2RegionCalibrationFactor": {
          "type": "number",
          "description": "Core ESC SCORE2 low-risk region calibration factor (manual review only, guardrail 0.75-1.05)."
        },
        "findriscHighRiskCutoff": {
          "type": "number",
          "description": "Core FINDRISC screening cutoff (manual review only, guardrail 10-15)."
        },
        "wcrfRelativeRiskSlope": {
          "type": "number",
          "description": "Core WCRF/IARC relative risk slope (manual review only, guardrail 1.80-2.50)."
        }
      },
      "required": [
        "version",
        "updatedAt",
        "updatedBy",
        "updateMode",
        "changeSummary",
        "dailyStepsOptimalThreshold",
        "dailyStepsLowThreshold",
        "whoWeeklyMinutesTarget",
        "upfHighRiskOncoPoints",
        "redMeatWeeklyLimit",
        "fruitVegDailyTarget",
        "alcoholLowRiskWeeklyLimit",
        "euDefaultTotalCholMgDl",
        "euPopCvdMedianMultiplier",
        "euPopOncoMedianOffset",
        "score2RegionCalibrationFactor",
        "findriscHighRiskCutoff",
        "wcrfRelativeRiskSlope"
      ]
    },
    "ParameterProposalDoc": {
      "title": "ParameterProposalDoc",
      "description": "Evidence-backed proposal to update a clinical calculation parameter, classified as guarded_auto or manual_review.",
      "type": "object",
      "properties": {
        "parameterKey": {
          "type": "string",
          "enum": [
            "dailyStepsOptimalThreshold",
            "dailyStepsLowThreshold",
            "whoWeeklyMinutesTarget",
            "upfHighRiskOncoPoints",
            "redMeatWeeklyLimit",
            "fruitVegDailyTarget",
            "alcoholLowRiskWeeklyLimit",
            "euDefaultTotalCholMgDl",
            "euPopCvdMedianMultiplier",
            "euPopOncoMedianOffset",
            "score2RegionCalibrationFactor",
            "findriscHighRiskCutoff",
            "wcrfRelativeRiskSlope"
          ]
        },
        "parameterLabel": {
          "type": "string",
          "minLength": 3,
          "maxLength": 140
        },
        "governanceTier": {
          "type": "string",
          "enum": ["guarded_auto", "manual_review"]
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "auto_applied", "rejected"]
        },
        "currentValue": {
          "type": "number"
        },
        "proposedValue": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "sourceAuthority": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "pmidOrReference": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "sourceUrl": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300,
          "pattern": "^https://.*$"
        },
        "rationale": {
          "type": "string",
          "minLength": 10,
          "maxLength": 700
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        }
      },
      "required": [
        "parameterKey",
        "parameterLabel",
        "governanceTier",
        "status",
        "currentValue",
        "proposedValue",
        "unit",
        "sourceAuthority",
        "pmidOrReference",
        "sourceUrl",
        "rationale",
        "createdAt",
        "updatedAt"
      ]
    },
    "ParameterRevisionDoc": {
      "title": "ParameterRevisionDoc",
      "description": "Immutable audit snapshot of a published clinical parameter version enabling instant rollback.",
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24,
          "pattern": "^v[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "actorEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "updateMode": {
          "type": "string",
          "enum": ["baseline", "guarded_auto", "manual_review", "rollback"]
        },
        "changeSummary": {
          "type": "string",
          "minLength": 4,
          "maxLength": 500
        },
        "snapshot": {
          "type": "object",
          "description": "Map of the numeric clinical parameters saved in this version."
        }
      },
      "required": [
        "version",
        "createdAt",
        "actorEmail",
        "updateMode",
        "changeSummary",
        "snapshot"
      ]
    },
    "MonitoringDigestDoc": {
      "title": "MonitoringDigestDoc",
      "description": "Shared 30-day cached academic research digest from PubMed, Google Scholar, and Fondazione AIRC.",
      "type": "object",
      "properties": {
        "lastMonthlyScanIso": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40
        },
        "cadenceDays": {
          "type": "number"
        },
        "livePubMedCount": {
          "type": "number"
        },
        "aiSynthesisNote": {
          "type": "string",
          "maxLength": 4000
        },
        "sourcesTracked": {
          "type": "array"
        },
        "monthlySeries": {
          "type": "array"
        },
        "emergingTrends": {
          "type": "array"
        },
        "publications": {
          "type": "array"
        },
        "groundingSources": {
          "type": "array"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "lastMonthlyScanIso",
        "cadenceDays",
        "livePubMedCount",
        "sourcesTracked",
        "monthlySeries",
        "emergingTrends",
        "publications",
        "groundingSources",
        "updatedAt"
      ]
    },
    "AdminMarkerDoc": {
      "title": "AdminMarkerDoc",
      "description": "Optional explicit curator/admin registry document keyed by Firebase UID.",
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": ["admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["role", "createdAt"]
    }
  },
  "firestore": {
    "/clinical_parameters/{paramDocId}": {
      "schema": { "$ref": "#/entities/ClinicalParametersDoc" },
      "description": "Public read-only clinical parameter configuration (singleton docId: active). Writable only by verified clinical curator."
    },
    "/parameter_proposals/{proposalId}": {
      "schema": { "$ref": "#/entities/ParameterProposalDoc" },
      "description": "Publicly readable proposals for guarded auto-updates and manual protocol reviews. Writable only by verified clinical curator."
    },
    "/parameter_revisions/{revisionId}": {
      "schema": { "$ref": "#/entities/ParameterRevisionDoc" },
      "description": "Immutable audit trail of clinical parameter versions for transparent history and rollback."
    },
    "/monitoring_digests/{digestId}": {
      "schema": { "$ref": "#/entities/MonitoringDigestDoc" },
      "description": "Shared 30-day cached PubMed/Google Scholar/AIRC research digest (singleton docId: latest)."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminMarkerDoc" },
      "description": "Restricted curator registry; never readable or writable by standard clients."
    }
  }
}
